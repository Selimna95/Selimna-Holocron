{
  "name": "selimnas-holocron-v3",
  "version": "3.2.1",
  "private": true,
  "description": "Holocron Sith — SWGOH Optimizer web app",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . && stylelint 'app.css' 'sithari.css' 'pages.css'",
    "format:check": "prettier --check \"**/*.{js,mjs,json,css,html,md,yml}\"",
    "test:js": "vitest run",
    "test:e2e": "playwright test",
    "test:python": "python -m unittest discover -s tests -v",
    "css:budget": "node scripts/check-css-budget.mjs",
    "check": "npm run lint && npm run test:js && npm run test:profiles && npm run test:python && npm run css:budget && npm run build",
    "format": "prettier --write \"**/*.{js,mjs,json,css,html,md,yml}\"",
    "test:profiles": "python scripts/generate-profile-index.py --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "acorn": "^8.15.0",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "stylelint": "^16.23.1",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
